<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.magnusp.turso</groupId>
    <artifactId>turso-jdbc</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Turso JDBC</name>
    <description>JDBC driver for embedded Turso, backed by Panama FFM over the turso_sdk_kit C ABI</description>
    <url>https://github.com/magnusp/turso-jdbc</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <slf4j.version>2.0.20</slf4j.version>
        <xerial.version>3.53.4.0</xerial.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>turso-jdbc.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>turso-jdbc.properties</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
                <executions>
                    <execution>
                        <!-- The exported reference tests use deprecated JDBC API on purpose. -->
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>-Xlint:-deprecation</arg>
                                <arg>-XDsuppressNotes</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>verify-vendored-upstream</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="true">
                                    <arg value="${project.basedir}/tools/export-upstream" />
                                    <arg value="--verify" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-xerial-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/generated-test-sources/xerial" />
                                <copy todir="${project.build.directory}/generated-test-sources/xerial">
                                    <fileset
                                        dir="${project.basedir}/upstream-xerial_sqlite-jdbc"
                                        includesfile="${project.basedir}/upstream-xerial_sqlite-jdbc.manifest" />
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>add-conformance-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/src/conformance/java</source>
                                <source>${project.build.directory}/generated-test-sources/xerial</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-conformance-test-resources</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>add-test-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/conformance/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <excludes>
                        <exclude>**/org/sqlite/**</exclude>
                        <exclude>**/io/github/magnusp/turso/conformance/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>conformance</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <!-- The manifest decides which reference test classes are copied into
                         generated-test-sources, so the org.sqlite package pattern follows
                         the manifest without a second class list. The conformance package
                         holds the harness tests. -->
                    <includes>
                        <include>**/sqlite/*Test.java</include>
                        <include>**/conformance/*Test.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <conformance.report.enabled>true</conformance.report.enabled>
                        <conformance.report.file>${project.build.directory}/conformance-summary.txt</conformance.report.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Reference probe: run the same exported test tree against
            org.xerial:sqlite-jdbc 3.53.4.0 instead of the Turso driver. The
            result describes the reference implementation, not a target for Turso.
        -->
        <profile>
            <id>xerial-control</id>
            <dependencies>
                <dependency>
                    <groupId>org.xerial</groupId>
                    <artifactId>sqlite-jdbc</artifactId>
                    <version>${xerial.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- The reference probe must not run the fast Turso fit
                                 suite through the reference driver. -->
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/sqlite/*Test.java</include>
                            </includes>
                            <excludes combine.self="override">
                                <exclude>**/io/github/magnusp/turso/conformance/**</exclude>
                            </excludes>
                            <systemPropertyVariables combine.self="override">
                                <conformance.control.driver>xerial</conformance.control.driver>
                                <conformance.report.enabled>true</conformance.report.enabled>
                                <conformance.report.file>${project.build.directory}/conformance-summary.txt</conformance.report.file>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
